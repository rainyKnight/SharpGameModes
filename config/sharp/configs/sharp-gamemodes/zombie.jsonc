{
  // Example zombie-infection settings using stock CS2 model resources.
  "enabled": true,
  "prefix": "[Zombie]",
  "minimum_players": 2,
  "include_bots_in_round": false,
  "first_infection_delay_seconds": 15,
  "round_duration_seconds": 180,
  "post_round_delay_seconds": 5,
  "minimum_initial_zombies": 1,
  "initial_zombie_ratio": 0.25,
  "maximum_initial_zombies": 0,
  "zombie_health": 18000,
  "mother_zombie_health": 30000,
  "zombie_speed": 1.25,
  "zombie_lives": 0,
  "zombie_respawn_delay_seconds": 1,
  "zombie_heal_on_infect": 300,
  "corpse_infection_delay_seconds": 5,
  "corpse_respawn_z_offset": 16,
  "corpse_marker_enabled": true,
  "corpse_marker_model": "",
  "corpse_marker_animation": "idle",
  "corpse_marker_z_offset": 16,
  "corpse_marker_scale": 1,
  "corpse_marker_alpha": 120,
  "corpse_marker_red": 255,
  "corpse_marker_green": 64,
  "corpse_marker_blue": 64,
  "corpse_marker_glow_range": 1800,
  "corpse_marker_glow_type": 3,
  "knockback_enabled": true,
  "disable_hit_slowdown": true,
  "knockback_base_force": 0,
  "knockback_damage_scale": 10,
  "knockback_vertical_boost": 0,
  "knockback_max_horizontal_speed": 1200,
  "manual_round_accounting": true,
  "zombie_knife_light_damage": 60,
  "zombie_knife_heavy_damage": 120,
  "zombie_knife_heavy_damage_threshold": 60,
  "human_health": 100,
  "human_speed": 1,
  "human_armor": 100,
  "zombie_armor": 3000,
  "spawn_full_armor": true,
  "spawn_helmet": true,
  "infinite_human_ammo": true,
  "disable_fall_damage": true,
  "fall_sound_suppress_seconds": 1,
  "fall_sound_velocity_threshold": 500,
  "debug_fall_sound_messages": false,
  "disable_damage_shake": true,
  "block_standard_buy_commands": true,
  "block_zombie_buy": true,
  "blocked_buy_items": ["flashbang", "smokegrenade"],
  "block_human_weapon_drop": true,
  "show_drop_blocked_message": true,
  "block_player_model_commands_for_zombies": true,
  "show_weapon_help_on_human_spawn": true,
  "weapon_help_message": "{prefix} 人类用 !guns 看枪械指令，例：!ak、!m4、!awp、!de；所有人可用 !fdy 买满甲。",
  "apply_zombie_model_delay_seconds": 0.25,
  "zombie_models": ["characters/models/tm_phoenix/tm_phoenix.vmdl"],
  "mother_zombie_models": []
}
