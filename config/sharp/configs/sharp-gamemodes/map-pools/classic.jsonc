// Example classic pool using only stock CS2 maps.
{
  "mode": "classic",
  "display_name": "Classic",
  "auto_team": {
    "enabled": true,
    "lock_team_select": true,
    "auto_assign_on_join": true,
    "balance_on_round_start": true,
