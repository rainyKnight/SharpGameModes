<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SharpGameModes.Cosmetics</AssemblyName>
    <RootNamespace>SharpGameModes.Cosmetics</RootNamespace>
    <Description>Weapon paint and knife preferences for ModSharp servers.</Description>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModSharp.Sharp.Shared" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="ModSharp.Sharp.Modules.MenuManager.Shared" PrivateAssets="all" ExcludeAssets="runtime" />
    <ProjectReference Include="../SharpGameModes.Contracts/SharpGameModes.Contracts.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../SharpGameModes.Domain/SharpGameModes.Domain.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../SharpGameModes.Cosmetics.Storage/SharpGameModes.Cosmetics.Storage.csproj" />
  </ItemGroup>
</Project>
