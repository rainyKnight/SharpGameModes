{
  // Functional example. The complete BotMatch map pool and upstream datasets
  // are distributed with the project.
  "schema_version": 1,
  "enabled": true,
  "prefix": "[BotMatch]",
  "bot_quota": 10,
  "bot_quota_mode": "fill",
  "balance_bot_teams": true,
  "team_balance_delay_seconds": 0.75,
  // Disabled after live validation: even length-preserving changes to the
  // native svc_*StringTable protobuf race CS2's network worker threads.
  "hide_bot_identity": false,
  // The upstream bundle pairs this catalog with a matching botprofile.db.
  // Use the selected catalog name here so the pure ModSharp package keeps
  // each visible name aligned with its Steam profile even without that override.
  "use_bot_info_names": true,
  "synthetic_steam_id_base": 76561199500000000,
  "fake_ping_min": 18,
  "fake_ping_max": 72,
  "knife_after_team_elimination": true,
  // Reversible BotAI 1.8.7 server-code patches; activated atomically.
  "enable_bot_ai": true,
  "enable_bot_state": true,
  // Full BotBuy economy logic: alternate buys, refunds, gifts and last-round eco.
  "enable_bot_buy": true,
  // Stable per-bot agents, music kits, knives, gloves, paints, stickers and charms.
  // Hooks and delayed work exist only while botmatch is active.
  "enable_bot_cosmetics": true,
  // Latest RoundDamageRecap: auto selects pw for Chinese clients, otherwise classic.
  "enable_damage_recap": true,
  "damage_recap_style": "auto",
  // low / medium / hltvtop10 / high => 简单 / 普通 / 困难 / 噩梦.
  // HLTVTop10 contains the current first 10 teams from the upstream pro-team list.
  "difficulty_tier": "hltvtop10",
  "persona_names": [
    "Aster", "Breeze", "Cobalt", "Drizzle", "Echo",
    "Frost", "Glint", "Harbor", "Iris", "Jade",
    "Kite", "Lumen", "Mica", "Nova", "Onyx",
    "Pine", "Quartz", "Rook", "Sol", "Tide"
  ],
  "aim_mode": "mixed",
  // off / less / normal / more / max; only active in botmatch.
  "nade_mode": "less",
  // Values are leased only while botmatch is active and restored on exit.
  "con_vars": {
    "bot_difficulty": "5",
    "custom_bot_difficulty": "5",
    "sv_auto_adjust_bot_difficulty": "false",
    "bot_allow_grenades": "0",
    "bot_max_visible_smoke_length": "50",
    "bot_allow_rogues": "0",
    "bot_eco_limit": "2800",
    "bot_randombuy": "0",
    "bot_defer_to_human_items": "0",
    "bot_defer_to_human_goals": "0",
    "bot_defense_rush_chance": "0",
    "bot_auto_vacate": "1",
    "bot_auto_follow": "0",
    "bot_join_after_player": "0",
    "bot_stop": "0",
    "bot_freeze": "0",
    // Required by ServerAvatarOverrides; restored when botmatch deactivates.
    "sv_reliableavatardata": "1",
    "bot_max_vision_distance_override": "30000",
    "bot_coop_idle_max_vision_distance": "30000",
    "nav_pathfind_multithread": "true",
    "nav_test_path_return": "true",
    "nav_test_detour": "true",
    "nav_pathfind_inadmissable_heuristic_factor": "2.5",
    "nav_potentially_visible_dot_tolerance": "-1",
    "sv_shared_team_pvs": "true",
    "ai_use_visibility_cache": "2",
    "nav_max_view_distance": "30000"
  }
}
