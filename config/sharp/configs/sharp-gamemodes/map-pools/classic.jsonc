    },
    "de_mirage": {
      "enabled": true,
      "display_name": "Mirage",
      "workshop": false,
      "workshop_id": "",
      "min_players": 0,
      "max_players": 64,
      "weight": 1
    },
    "de_inferno": {
      "enabled": true,
      "display_name": "Inferno",
      "workshop": false,
