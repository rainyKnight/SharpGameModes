{
  // Example configuration. Adjust vote thresholds for your own community.
  "schema_version": 1,
  "enabled": true,
  // Relative paths are resolved from game/sharp.
  "state_path": "data/sharp-gamemodes/map-system-state.json",
  "vote": {
    "duration_seconds": 25,
    "maps_in_vote": 5,
    "remember_played_maps": 3
  },
  "map_change": {
    "delay_after_match_seconds": 8
  },
  "rtv": {
    "enabled": true,
    "initial_delay_seconds": 30,
    "required_ratio": 0.5,
    "cooldown_seconds_after_vote": 0
  },
  "nomination": {
    "enabled": true,
    "page_size": 5
  },
  // AGPL source offer. Forks and modified deployments should point this URL
  // at the exact corresponding source they make available to players.
  "source_offer": {
    "show_on_join": true,
    "join_delay_seconds": 8,
    "url": "https://github.com/rainyKnight/SharpGameModes",
    // Set prefix to an empty string to show the message without a label.
    "prefix": "[SharpGameModes]",
    "message": "Source code / 源码: {url}",
    "commands": ["source", "源码"]
  },
  "mode_auto_change_rules": {
    "classic": {
      "enabled": true,
      "auto_change_mode": "rounds",
      "vote_start_round": 8
    },
    "tdm": {
      "enabled": true,
      "auto_change_mode": "rounds",
      "vote_start_round": 1
    },
    "zombie": {
      "enabled": true,
      "auto_change_mode": "rounds_sum",
      "vote_start_round": 3,
      "change_after_round": 6
    },
    "botmatch": {
      "enabled": true,
      "auto_change_mode": "rounds",
      "vote_start_round": 8
    }
  }
}
